# Eaves Development Environment Variables
#
# Copy this file to `.env` and fill in any values you want pre-seeded on the
# first run of a fresh install. Everything here is optional — the app works
# without an `.env` file, and the same values are editable from Settings →
# Providers (API keys) and the OOBE wizard (user name).
#
# This file is ONLY read on app startup, so changes require an app restart
# to take effect.

# ─── User Identity ─────────────────────────────────────────────────────────
# Seeds your display name into a fresh database. Ignored after the first run
# (the settings row already exists). Change it via Settings → General.
USER_NAME=User

# ─── Provider API Keys ─────────────────────────────────────────────────────
# Seeded into the encrypted api_keys store on the first run. Ignored after
# that — Settings → Providers is the source of truth once the DB exists.
# Leave blank to skip a provider; you can also add keys later in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Local endpoints — the "key" field is rarely required by the local server
# itself; Eaves just stores whatever value you set for outbound auth.
OLLAMA_API_KEY=
LMSTUDIO_API_KEY=

# ─── Diagnostics ───────────────────────────────────────────────────────────
# Filter the main-process logger output. One of: DEBUG, INFO, WARN, ERROR.
# Defaults to INFO. Use DEBUG when investigating IPC / sandbox / dispatcher
# issues; the log file lives in your data directory.
EAVES_LOG_LEVEL=INFO
