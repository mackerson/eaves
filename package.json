{
  "name": "eaves",
  "version": "0.4.2",
  "desktopName": "eaves.desktop",
  "description": "AI chat that remembers your projects, works offline, and respects your privacy",
  "author": "Ackerson Labs <oss@ackersonlabs.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mackerson/eaves.git"
  },
  "homepage": "https://github.com/mackerson/eaves#readme",
  "bugs": "https://github.com/mackerson/eaves/issues",
  "main": "dist/main/main/main.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3 && bash scripts/sign-native-macos.sh && node scripts/build-plugins.js",
    "pretest": "npm rebuild better-sqlite3",
    "predev": "electron-rebuild -f -w better-sqlite3 && bash scripts/sign-native-macos.sh",
    "dev": "node scripts/dev-init.js && concurrently \"yarn dev:renderer\" \"yarn dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "electron .",
    "dev:rebuild": "node scripts/build-plugins.js --force && yarn build:mcp && yarn build:main && yarn copy-assets && yarn copy-plugins",
    "dev:clean": "bash scripts/clean-dev.sh && yarn dev",
    "kill:dev": "bash scripts/clean-dev.sh",
    "dev:status": "ps aux | grep -E 'electron|yarn dev|vite' | grep -v grep || echo 'No dev processes running'",
    "prebuild": "node scripts/build-plugins.js",
    "build": "yarn typecheck && yarn build:renderer && yarn build:main && yarn build:mcp && yarn copy-assets && yarn copy-plugins",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:mcp": "tsc -p tsconfig.mcp.json && node -e \"require('fs').writeFileSync('dist/main/mcp-servers/package.json', JSON.stringify({ type: 'module' }) + '\\n')\"",
    "build:plugins": "node scripts/build-plugins.js",
    "generate:icons": "bash scripts/generate-icons.sh",
    "copy-assets": "mkdir -p dist/assets && cp -r assets/* dist/assets/",
    "copy-plugins": "node scripts/copy-plugins.js",
    "start": "electron .",
    "prepare:native": "electron-rebuild -f -w better-sqlite3 && bash scripts/sign-native-macos.sh",
    "prepackage": "yarn prepare:native && yarn build",
    "package": "electron-builder",
    "package:mac": "yarn prepare:native && yarn build && set -a && . ./.env.local && set +a && electron-builder --mac",
    "reinstall": "pkill -x Electron || true && rm -rf ~/Library/Application\\ Support/eaves/eaves-data && yarn rebuild-sqlite3 && yarn dev",
    "rebuild-sqlite3": "electron-rebuild -f -w better-sqlite3",
    "setup:plugins": "bash scripts/setup-plugins.sh",
    "setup:plugins:pull": "bash scripts/setup-plugins.sh --pull",
    "reset:dev": "bash scripts/reset-dev-env.sh",
    "reset:dev:force": "bash scripts/reset-dev-env.sh --force",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "npm rebuild better-sqlite3 --silent && vitest run",
    "test:watch": "npm rebuild better-sqlite3 --silent && vitest --watch",
    "test:coverage": "npm rebuild better-sqlite3 --silent && vitest run --coverage",
    "jscpd": "jscpd src",
    "knip": "knip",
    "jscpd:ci": "jscpd src --exitCode 1",
    "seed": "node scripts/qa/seed.mjs",
    "seed:demo": "yarn rebuild-sqlite3 && yarn build:main && yarn build:renderer && node scripts/qa/harness.mjs launch --fresh && node scripts/qa/seed.mjs --scenario=demo",
    "seed:stop": "node scripts/qa/harness.mjs stop"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lydell/node-pty": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^6.0.168",
    "better-sqlite3": "^12.4.1",
    "bonjour-service": "^1.4.1",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.3",
    "glob": "^13.0.0",
    "lucide-react": "^0.544.0",
    "node-telegram-bot-api": "^0.67.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.1",
    "selfsigned": "^5.5.0",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tar": "^6.2.1",
    "zod": "^4.1.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.8",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/ui": "^4.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.0.0",
    "electron-rebuild": "^3.2.9",
    "happy-dom": "^20.0.10",
    "jscpd": "^4.0.5",
    "knip": "6.27.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^4.0.4"
  },
  "build": {
    "appId": "com.eaves.app",
    "productName": "Eaves",
    "publish": [
      {
        "provider": "github",
        "owner": "mackerson",
        "repo": "eaves",
        "private": false
      }
    ],
    "appImage": {
      "artifactName": "Eaves-${version}.${ext}"
    },
    "files": [
      "dist/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/sqlite-vec-*/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Eaves-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "assets/icons/",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network",
      "desktop": {
        "entry": {
          "Keywords": "AI;chat;assistant;LLM;agents;local;privacy;"
        }
      }
    }
  }
}
