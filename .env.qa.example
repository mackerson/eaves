# Live / keyed QA — example. Copy the vars you need into a GITIGNORED `.env.local`
# and fill in real keys. NEVER commit real keys. `.env.local` is already ignored.
#
#   cp .env.qa.example .env.local   # then edit .env.local
#
# The QA harness (scripts/qa/harness.mjs) loads .env.local and, on `launch`,
# injects any provider key below into the fresh isolated profile's settings over
# CDP — the value never touches a command line, a commit, or a log (only the
# provider name is printed). This is what lets live suites make real model calls.

# Provider API keys (set the one[s] you have). Only these are read.
EAVES_QA_OPENROUTER_KEY=
# EAVES_QA_ANTHROPIC_KEY=
# EAVES_QA_OPENAI_KEY=
# EAVES_QA_GOOGLE_KEY=

# Which provider/model the live suites drive (defaults: openrouter / a cheap model).
EAVES_QA_PROVIDER=openrouter
EAVES_QA_MODEL=z-ai/glm-4.6
