# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
out/
release/

# Build config (keep build/entitlements.mac.plist)
# Note: build/ directory is tracked for electron-builder config

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Private context (never commit)
.claude/context-private.md
.claude/settings.local.json
.claude/conversation_export.md
.claude/sync-product-context.md
.claude/worktrees/

# Local tool state (desloppify, etc.)
.desloppify/

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# JSCPD duplicate code reports
jscpd-report/

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Electron specific
app/
release/src/shared/*.js

# Plugins (symlinked from sibling repos via setup-plugins.sh)
# Run `yarn setup:plugins` to clone and link plugin repos
plugins/
!plugins/README.md

# Prevent compiled JS files in source directories
src/shared/*.js
src/main/*.js
src/renderer/*.js

# TypeScript incremental build cache
*.tsbuildinfo
dist/.tsbuildinfo*

# Local conversation dumps (not for the repo)
conversation-dumps/


# Internal QA / forensic reports — local-only, never in the repo
docs/qa/

# Stray test fixture that node-telegram-bot-api drops at the repo root
.env.msu-silo
